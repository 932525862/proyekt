# Public site origin. On App Platform set it at RUN_AND_BUILD_TIME; on a Droplet set it during build and runtime.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Persistent data root. On a DigitalOcean Droplet use /var/lib/novalab
# to keep the local SQLite database and uploaded images across code deployments.
NOVALAB_DATA_DIR=.data

# Admin authentication (both secrets required in production).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
AUTH_SECRET=

# Optional: Turso/libSQL for App Platform or an externally managed database.
# A Droplet can use the local SQLite database under NOVALAB_DATA_DIR instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: DigitalOcean Spaces for App Platform or remote image storage.
# A Droplet can store uploads on its persistent local disk instead.
SPACES_BUCKET=
SPACES_REGION=
SPACES_KEY=
SPACES_SECRET=
# Optional override; defaults to https://<region>.digitaloceanspaces.com
SPACES_ENDPOINT=
# Optional: set to the CDN endpoint, e.g. https://bucket.region.cdn.digitaloceanspaces.com
SPACES_CDN_URL=

# Optional integrations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
